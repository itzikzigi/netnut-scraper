NODE_ENV=development

# Service ports
API_PORT=3000
JOB_MANAGER_PORT=3001
SCRAPER_PORT=3002

# Service-to-service URLs
JOB_MANAGER_URL=http://localhost:3001

# Sync-mode timeout for ?wait=true (ms)
SCRAPE_WAIT_TIMEOUT_MS=30000

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=netnut
POSTGRES_PASSWORD=netnut
POSTGRES_DB=netnut

# Redis (BullMQ + Pub/Sub + HTML result cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# Scraped HTML is cached in Redis with this TTL (seconds), not persisted in
# Postgres. After it expires, GET /scrape/:id returns metadata without html.
RESULT_TTL_SECONDS=3600

# Fetcher (Scraper)
FETCH_TIMEOUT_MS=20000
FETCH_USER_AGENT=NetnutScraperBot/0.1

# Concurrent jobs processed per scraper worker. Scraping is network-bound
# (each fetch blocks on the timeout above), so >1 dramatically improves
# throughput per pod. Default 10.
SCRAPER_CONCURRENCY=10

# Max response body size in bytes. The body is buffered fully into memory and
# cached in Redis, so this is a hard ceiling against huge/hostile pages. ~5 MB.
FETCH_MAX_BYTES=5000000

# SSRF guard escape hatch. When false (default), targets that resolve to
# private/internal/loopback/link-local addresses are rejected. Set true ONLY
# for local dev that legitimately scrapes localhost.
ALLOW_PRIVATE_TARGETS=false

# Proxy pool — comma-separated. Empty = direct fetch.
# Example: PROXY_POOL=http://user:pass@proxy1.example.com:8080,http://proxy2.example.com:8080
PROXY_POOL=

# TypeORM (optional)
TYPEORM_LOGGING=false

# DB schema sync. Defaults: on in non-prod, off in prod. Set explicitly to
# decouple from NODE_ENV (e.g. compose / k8s demos that want NODE_ENV=production
# but still need auto-sync because no migrations are wired yet).
DB_SYNCHRONIZE=true
