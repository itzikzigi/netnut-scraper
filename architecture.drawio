<mxfile host="app.diagrams.net" agent="Claude" version="22.0.0">
  <diagram id="netnut-arch" name="System Architecture">
    <mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Netnut Scraper — System Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Nest.js monorepo · async-first · Postgres + BullMQ/Redis · rotating proxy pool" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="800" height="20" as="geometry" />
        </mxCell>

        <mxCell id="client" value="Client / User" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="90" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="api_tier_box" value="API Tier (Nest HTTP services)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;verticalAlign=top;fontStyle=2;fontSize=11;dashed=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="440" y="170" width="380" height="240" as="geometry" />
        </mxCell>

        <mxCell id="api" value="&lt;b&gt;API Service&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;POST /scrape · GET /scrape/:id&lt;br/&gt;Calls Job Manager via REST · Redis SUBSCRIBE for ?wait=true&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="470" y="200" width="320" height="75" as="geometry" />
        </mxCell>

        <mxCell id="jobmgr" value="&lt;b&gt;Job Manager Service&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;validate (DTO) · persist · enqueue · read&lt;br/&gt;Owns the Job state machine&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="470" y="310" width="320" height="75" as="geometry" />
        </mxCell>

        <mxCell id="data_tier_box" value="Data Tier" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;verticalAlign=top;fontStyle=2;fontSize=11;dashed=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="380" height="220" as="geometry" />
        </mxCell>

        <mxCell id="pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;jobs(id, url, status, html,&lt;br/&gt;error, attempts, proxy_used,&lt;br/&gt;created_at, updated_at)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="475" width="140" height="130" as="geometry" />
        </mxCell>

        <mxCell id="redis" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;BullMQ queue&lt;br/&gt;&lt;i&gt;scrape-jobs&lt;/i&gt;&lt;br/&gt;Pub/Sub channel&lt;br/&gt;&lt;i&gt;job:&amp;lt;id&amp;gt;:done&lt;/i&gt;&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="475" width="140" height="130" as="geometry" />
        </mxCell>

        <mxCell id="worker_tier_box" value="Worker Tier (horizontally scaled · HPA on queue depth)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;verticalAlign=top;fontStyle=2;fontSize=11;dashed=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="440" y="430" width="240" height="220" as="geometry" />
        </mxCell>

