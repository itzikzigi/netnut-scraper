          <mxGeometry x="460" y="465" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="w2" value="Scraper Worker 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="540" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="wn" value="Scraper Worker N" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="595" width="200" height="40" as="geometry" />
        </mxCell>

        <mxCell id="egress_box" value="Egress / External" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;verticalAlign=top;fontStyle=2;fontSize=11;dashed=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="700" y="430" width="500" height="220" as="geometry" />
        </mxCell>

        <mxCell id="proxy" value="&lt;b&gt;Proxy Pool&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;env: PROXY_POOL=url1,url2,...&lt;br/&gt;rotated per request&lt;br/&gt;(skipped when empty)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="730" y="475" width="180" height="140" as="geometry" />
        </mxCell>

        <mxCell id="target" value="&lt;b&gt;Target Website&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;Public HTTP(S) endpoint&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="970" y="510" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="1. POST /scrape&#10;{ url, [?wait=true] }" style="endArrow=classic;html=1;strokeColor=#333333;fontSize=10;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="client" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="6. 202 Accepted&#10;{ jobId }" style="endArrow=classic;html=1;strokeColor=#333333;dashed=1;fontSize=10;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="api" target="client">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="2. POST /jobs (REST)" style="endArrow=classic;html=1;strokeColor=#333333;fontSize=10;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="api" target="jobmgr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="5. { jobId }" style="endArrow=classic;html=1;strokeColor=#333333;dashed=1;fontSize=10;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="jobmgr" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="3. INSERT job&#10;(status=pending)" style="endArrow=classic;html=1;strokeColor=#333333;fontSize=10;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="jobmgr" target="pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="4. queue.add()&#10;(BullMQ)" style="endArrow=classic;html=1;strokeColor=#333333;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="jobmgr" target="redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e7" value="7. Consume" style="endArrow=classic;html=1;strokeColor=#82b366;fontSize=10;strokeWidth=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="redis" target="w1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e8" value="8. UPDATE&#10;status=in_progress" style="endArrow=classic;html=1;strokeColor=#82b366;fontSize=10;strokeWidth=2;" edge="1" parent="1" source="w1" target="pg">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="450" y="450" />
              <mxPoint x="150" y="450" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e9" value="9. HTTP via proxy" style="endArrow=classic;html=1;strokeColor=#82b366;fontSize=10;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="w1" target="proxy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="10. GET url" style="endArrow=classic;html=1;strokeColor=#82b366;fontSize=10;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="proxy" target="target">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="11. HTML" style="endArrow=classic;html=1;strokeColor=#82b366;dashed=1;fontSize=10;strokeWidth=2;" edge="1" parent="1" source="target" target="w1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1070" y="660" />
              <mxPoint x="560" y="660" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e12" value="12. UPDATE&#10;status=completed, html=…" style="endArrow=classic;html=1;strokeColor=#82b366;fontSize=10;strokeWidth=2;" edge="1" parent="1" source="w1" target="pg">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="440" y="675" />
              <mxPoint x="150" y="675" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e13" value="13. PUBLISH&#10;job:&lt;id&gt;:done" style="endArrow=classic;html=1;strokeColor=#82b366;fontSize=10;strokeWidth=2;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="w1" target="redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note_read" value="&lt;b&gt;Read flow (polling, default async mode)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;A. Client → API:&amp;nbsp;&lt;b&gt;GET /scrape/:id&lt;/b&gt;&lt;br/&gt;B. API → Job Manager: GET /jobs/:id (REST)&lt;br/&gt;C. Job Manager → Postgres: SELECT&lt;br/&gt;D. Returns { status, html?, error? }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="290" height="130" as="geometry" />
        </mxCell>

        <mxCell id="note_wait" value="&lt;b&gt;Sync mode (?wait=true)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;After step 4, API does NOT return 202.&lt;br/&gt;It &lt;b&gt;SUBSCRIBE&lt;/b&gt;s to job:&amp;lt;id&amp;gt;:done on Redis.&lt;br/&gt;When the Worker publishes (step 13), API reads&lt;br/&gt;the completed row from Postgres via Job Manager&lt;br/&gt;and returns 200 + HTML. Falls back to 504 on timeout." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="350" y="690" width="320" height="130" as="geometry" />
        </mxCell>

        <mxCell id="note_failure" value="&lt;b&gt;Failure handling&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;BullMQ retries with exponential backoff (3×).&lt;br/&gt;Each attempt picks a different proxy from the pool.&lt;br/&gt;Final failure → status=failed, error stored on row.&lt;br/&gt;Worker crash mid-job → BullMQ stalled-job recovery&lt;br/&gt;re-enqueues automatically." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="690" y="690" width="290" height="130" as="geometry" />
        </mxCell>

        <mxCell id="note_k8s" value="&lt;b&gt;K8s deployment (bonus)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;3 Deployments: api, job-manager, scraper.&lt;br/&gt;ClusterIP Services for api↔jobmgr.&lt;br/&gt;Scraper HPA on queue depth (or CPU as MVP).&lt;br/&gt;Postgres &amp;amp; Redis as StatefulSets / managed.&lt;br/&gt;Bull Board exposed at /admin/queues." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1000" y="690" width="260" height="130" as="geometry" />
        </mxCell>

        <mxCell id="legend_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1000" y="60" width="260" height="100" as="geometry" />
        </mxCell>
